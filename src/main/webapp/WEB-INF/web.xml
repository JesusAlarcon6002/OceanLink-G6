<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <!-- Sesión: 30 min sin actividad y cookie JSESSIONID inaccesible desde JavaScript (HttpOnly).
         El atributo SameSite se fija en META-INF/context.xml. No se marca "Secure" porque el sitio
         se sirve por HTTP (sin dominio/certificado); si algún día hay HTTPS, agregar <secure>true</secure>. -->
    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
        </cookie-config>
    </session-config>

    <!-- Páginas de error propias: no se muestran trazas (stack traces) ni la versión de Tomcat -->
    <error-page>
        <error-code>404</error-code>
        <location>/WEB-INF/vistas/error.jsp</location>
    </error-page>
    <error-page>
        <error-code>405</error-code>
        <location>/WEB-INF/vistas/error.jsp</location>
    </error-page>
    <error-page>
        <error-code>429</error-code>
        <location>/WEB-INF/vistas/error.jsp</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/WEB-INF/vistas/error.jsp</location>
    </error-page>
    <error-page>
        <exception-type>java.lang.Throwable</exception-type>
        <location>/WEB-INF/vistas/error.jsp</location>
    </error-page>

</web-app>
